# QueryMind Configuration Template
# Copy this file to .env and fill in values as needed. Never commit .env to Git.

QUERYMIND_APP_ENV=development
# Optional pre-configured SQLite database path (leave blank to upload via UI).
# On Windows, prefer forward slashes or unquoted paths (avoid double-quoted backslashes).
QUERYMIND_DB_PATH=
QUERYMIND_UPLOAD_DIR=data/uploads
QUERYMIND_MAX_UPLOAD_SIZE_MB=25
QUERYMIND_MAX_UPLOAD_FILES_PER_BATCH=15
QUERYMIND_MAX_TOTAL_UPLOAD_BATCH_MB=100

# Provider options: auto | fallback | gemini | openai_compatible
QUERYMIND_LLM_PROVIDER=auto

# Google Gemini (optional; leave blank to use deterministic fallback)
QUERYMIND_GEMINI_API_KEY=
QUERYMIND_GEMINI_MODEL=gemini-2.5-flash

# OpenAI-compatible provider (optional)
QUERYMIND_OPENAI_API_KEY=
QUERYMIND_OPENAI_BASE_URL=
QUERYMIND_OPENAI_MODEL=gpt-4o-mini

# Safety & Execution Limits
QUERYMIND_MAX_ROWS=500
QUERYMIND_QUERY_TIMEOUT_SECONDS=5.0
QUERYMIND_LLM_TIMEOUT_SECONDS=20.0

# API & Logging
QUERYMIND_API_HOST=127.0.0.1
QUERYMIND_API_PORT=8001
QUERYMIND_LOG_LEVEL=INFO
